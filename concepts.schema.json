{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GLOSAR basic word list (data/concepts.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "concepts"],
  "properties": {
    "version": { "const": 1 },
    "concepts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "group", "en", "ro"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "group": { "enum": ["numbers", "family", "body", "nature", "basic"] },
          "en": { "type": "string", "minLength": 1 },
          "ro": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
