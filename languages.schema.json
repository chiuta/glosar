{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GLOSAR language index (data/languages.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "languages"],
  "properties": {
    "version": { "const": 1 },
    "languages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "name", "family", "scripts", "orthographies", "dialects"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{3}$" },
          "name": { "type": "object", "required": ["en", "ro"], "propertyNames": { "pattern": "^[a-z]{2}$" }, "additionalProperties": { "type": "string", "minLength": 1 } },
          "also": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "endonym": { "type": ["string", "null"] },
          "family": { "type": "string", "minLength": 1 },
          "scripts": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" } },
          "orthographies": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": false, "required": ["id", "note"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "note": { "type": "object", "required": ["en"], "additionalProperties": { "type": "string", "minLength": 1 } } } }
          },
          "dialects": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "iso639_3": { "type": "string", "pattern": "^[a-z]{3}$" }, "name": { "type": "object", "required": ["en"], "additionalProperties": { "type": "string", "minLength": 1 } } } }
          }
        }
      }
    }
  }
}
