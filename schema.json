{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "lang",
    "headword",
    "pos",
    "gloss",
    "source"
  ],
  "properties": {
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "headword": {
      "type": "string",
      "minLength": 1
    },
    "pos": {
      "enum": [
        "noun",
        "verb",
        "adjective",
        "adverb",
        "pronoun",
        "preposition",
        "conjunction",
        "interjection",
        "phrase",
        "other"
      ]
    },
    "gloss": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audio": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
